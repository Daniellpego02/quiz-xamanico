# Meta Conversions API (CAPI) Configuration
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git!

# =============================================================================
# META PIXEL & CAPI
# =============================================================================

# Meta Pixel ID (can be public, used in client-side)
META_PIXEL_ID=1908080873443730

# Meta Access Token for Conversions API (MUST be server-side only!)
# Generate at: https://developers.facebook.com/tools/accesstoken/
# ⚠️ WARNING: Do NOT use VITE_ prefix - it exposes the token to client-side
META_ACCESS_TOKEN=your_meta_access_token_here

# Test Event Code (optional, for testing in Meta Events Manager)
# Use in Development/Preview environments only
# Remove or leave empty in Production
META_TEST_CODE=TEST55523

# =============================================================================
# BUCKPAY PAYMENT GATEWAY
# =============================================================================

# BuckPay Secret Key (server-side only)
BUCKPAY_SECRET_KEY=your_buckpay_secret_key

# BuckPay User Agent (request from your account manager)
BUCKPAY_USER_AGENT=your_user_agent

# =============================================================================
# VTURB VIDEO PLAYER (Optional)
# =============================================================================

# VTurb API Token
VTURB_API_TOKEN=your_vturb_token

# =============================================================================
# NOTES
# =============================================================================

# Environment Variable Prefixes:
# - No prefix (META_*, BUCKPAY_*): Server-side only, secure
# - VITE_ prefix: Exposed to client-side, use only for non-sensitive data
#
# Security Best Practices:
# ✅ Keep tokens secret
# ✅ Use Vercel's "Secret" type for sensitive variables
# ✅ Never commit tokens to git
# ✅ Rotate tokens regularly
# ❌ Don't use VITE_ prefix for tokens
# ❌ Don't log tokens in code
# ❌ Don't share tokens in screenshots

# Vercel Configuration:
# 1. Go to: https://vercel.com/your-project/settings/environment-variables
# 2. Add each variable above
# 3. Set META_ACCESS_TOKEN as "Secret" type
# 4. Apply to: Production, Preview, Development
# 5. Save and redeploy

# Validation:
# After deployment, test at: https://business.facebook.com/events_manager
# - Navigate to Test Events
# - Enter code: TEST55523
# - Complete quiz flow in incognito mode
# - Verify events appear within 20 seconds
